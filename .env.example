# Settings and secrets for the post-stream pipeline (copy to .env and fill in; .env is gitignored).
# Environment variables win over this file. See "Phase 6 setup" in docs/post-stream-spec.md.

# ---- Paths & preferences (tools/stream-pipeline/src/wabisanji_post/settings.py)
# Where OBS saves recordings (default: ~/Videos) and where sessions live
# (default: <recordings>/WabiSanji/sessions).
# WS_RECORDINGS_ROOT=C:\Users\you\Videos
# WS_SESSIONS_ROOT=C:\Users\you\Videos\WabiSanji\sessions
# Your time zone (IANA name; default: the system's).
# WS_TIMEZONE=Australia/Melbourne
# How prompts and messages refer to you (default: "the streamer").
# WS_STREAMER_NAME=Sam
# Words in a transcript that mean family is on stream, so not-family memes stay out.
# WS_FAMILY_PATTERN=\b(kiddo|kids)\b
# Your channel (defaults: the Wabi Sanji channel).
# WS_TWITCH_LOGIN=wabisanji
# WS_CHANNEL_NAME=Wabi Sanji
# WS_DISCORD_URL=https://discord.gg/your-invite
# Folder with the meme clips (default: stream.live.memes_dir in apps/screenshot-parser/config.yaml).
# WABISANJI_MEMES=C:\Users\you\Videos\memes
# Crop layouts for your OBS scenes (default: the packaged layouts.yaml).
# WS_LAYOUTS=C:\Users\you\stream\layouts.yaml
# Whisper device: auto (CUDA, else CPU), cuda or cpu.
# WS_WHISPER_DEVICE=auto

# ---- Twitch dev app (dev.twitch.tv/console/apps). Redirect URL: http://localhost:17563/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional: looked up from the channel name if blank
TWITCH_BROADCASTER_ID=

# ---- Discord webhook for the clips channel
DISCORD_CLIPS_WEBHOOK=

# ---- Optional (find uploaded videos by title): path to the Google OAuth desktop client JSON
YOUTUBE_CLIENT_SECRETS=

# ---- Instagram Reels (stream-social): Meta developer app, Facebook Login, redirect URI http://localhost:17565/
# See "Instagram" in docs/stream-setup.md.
META_APP_ID=
META_APP_SECRET=
# Only if the app uses Facebook Login for Business (permissions come from a configuration)
META_LOGIN_CONFIG_ID=
# Only if more than one granted Page has Instagram linked: your Page's name or id
INSTAGRAM_PAGE=

# ---- Optional chat recorder: a small always-on HTTP service with a chat archive (for
# stream-signals) and a viewer log (for stream-metrics). Without it those signals are skipped.
# RECORDER_URL=http://recorder.local:8787
RECORDER_TOKEN=
# RECORDER_CHANNEL=wabisanji
